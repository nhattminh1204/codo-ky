{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CodoKy (Windows Desktop)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "windows"
      ]
    },
    {
      "name": "CodoKy (Chrome Web)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "chrome"
      ]
    },
    {
      "name": "CodoKy (Web Server :8080)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "web-server",
        "--web-port=8080"
      ]
    }
  ]
}